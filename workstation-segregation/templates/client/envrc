# {{CLIENT_UC}} client environment (loaded by direnv). Generated by workstation-segregation; safe to edit.
# After editing, run `direnv allow` in this directory.
export WORKSTATION_CLIENT={{CLIENT_UC}}
# Client root; the shell integration sources .workstation/bash/*.sh from here.
export WORKSTATION_CLIENT_DIR="$(expand_path .)"

# Client-scoped AWS and Kubernetes config.
# Set AWS_PROFILE once .aws/config has a real profile.
# Discard inherited credentials and profile selection before client settings.
unset AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN AWS_SECURITY_TOKEN
unset AWS_PROFILE AWS_DEFAULT_PROFILE AWS_ROLE_ARN AWS_ROLE_SESSION_NAME AWS_WEB_IDENTITY_TOKEN_FILE
unset AWS_CONTAINER_CREDENTIALS_RELATIVE_URI AWS_CONTAINER_CREDENTIALS_FULL_URI \
  AWS_CONTAINER_AUTHORIZATION_TOKEN AWS_CONTAINER_AUTHORIZATION_TOKEN_FILE
export AWS_CONFIG_FILE="$(expand_path .aws/config)"
export AWS_SHARED_CREDENTIALS_FILE="$(expand_path .aws/credentials)"
# export AWS_PROFILE=REPLACE_ME
export KUBECONFIG="$(expand_path .kube/config)"

# Client-scoped Azure CLI login (az: tokens, profile, subscription). Discard inherited
# service-principal settings: az itself ignores most of these, but Azure SDKs
# (AZURE_*) and Terraform azurerm (ARM_*) would authenticate as another client with them.
unset AZURE_CLIENT_ID AZURE_CLIENT_SECRET AZURE_CLIENT_CERTIFICATE_PATH AZURE_CLIENT_CERTIFICATE_PASSWORD \
  AZURE_TENANT_ID AZURE_SUBSCRIPTION_ID AZURE_USERNAME AZURE_PASSWORD AZURE_FEDERATED_TOKEN_FILE
unset ARM_CLIENT_ID ARM_CLIENT_SECRET ARM_CLIENT_CERTIFICATE_PATH ARM_CLIENT_CERTIFICATE_PASSWORD \
  ARM_TENANT_ID ARM_SUBSCRIPTION_ID ARM_ACCESS_KEY ARM_SAS_TOKEN ARM_OIDC_TOKEN
export AZURE_CONFIG_DIR="$(expand_path .workstation/azure)"

# Client-scoped shell history (switched by the shell integration).
export HISTFILE="$(expand_path .bash_history)"

# Client-scoped GitHub CLI login (git uses it via .workstation/git/config).
# Token overrides take precedence over the client login; discard inherited ones.
# An inherited GH_HOST would let gh commands pass gh's empty-config auth gate.
unset GH_TOKEN GITHUB_TOKEN GH_ENTERPRISE_TOKEN GITHUB_ENTERPRISE_TOKEN GH_HOST
export GH_CONFIG_DIR="$(expand_path .workstation/gh)"

# Client-scoped tool config (.workstation/<tool>/).
export DOCKER_CONFIG="$(expand_path .workstation/docker)"
export HELM_CONFIG_HOME="$(expand_path .workstation/helm/config)"
export HELM_CACHE_HOME="$(expand_path .workstation/helm/cache)"
export TF_CLI_CONFIG_FILE="$(expand_path .workstation/terraform/terraformrc)"
export NPM_CONFIG_USERCONFIG="$(expand_path .workstation/npm/npmrc)"
export PIP_CONFIG_FILE="$(expand_path .workstation/python/pip.conf)"
export SOPS_AGE_KEY_FILE="$(expand_path .workstation/age/keys.txt)"
# NotebookLM CLI (nlm): Google login, Chrome login profile and aliases. Without
# this nlm uses ~/.notebooklm-mcp-cli, shared by every client.
export NOTEBOOKLM_MCP_CLI_PATH="$(expand_path .workstation/notebooklm)"

# Agent CLIs with a separate client account and local settings/state.
# Common user/admin skills remain discoverable. Controlled by
# ENABLE_AGENT_CLI_ISOLATION in workstation-segregation.conf at scaffold time.
{{AGENT_PREFIX}}export CLAUDE_CONFIG_DIR="$(expand_path .workstation/claude)"
{{AGENT_PREFIX}}export CODEX_HOME="$(expand_path .workstation/codex)"
{{AGENT_PREFIX}}unset CODEX_SQLITE_HOME

# GPT API scripts use only this client's private API settings. Clear every
# inherited exported OPENAI_* name, including future SDK options.
for _openai_var in $(compgen -e); do
  case "$_openai_var" in OPENAI_*) unset "$_openai_var" ;; esac
done
unset _openai_var CODEX_API_KEY CODEX_ACCESS_TOKEN
watch_file .workstation/openai/env
if [ -f .workstation/openai/env ]; then
  dotenv .workstation/openai/env
fi

# Optional. Enable only when this client needs it.
# uv: UV_CONFIG_FILE replaces ALL discovered uv config, including a repo's
# [tool.uv] settings; prefer UV_INDEX for an extra private index.
# export UV_CONFIG_FILE="$(expand_path .workstation/python/uv.toml)"
# export UV_INDEX="private=https://pypi.example.com/simple"
# export OP_ACCOUNT="<account>.1password.com"
# export K9S_CONFIG_DIR="$(expand_path .workstation/k9s)"

# Placeholder warnings: re-evaluated whenever these files change.
watch_file .workstation/git/config .workstation/npm/npmrc .workstation/terraform/terraformrc \
  .workstation/python/pip.conf .aws/config
if ! git config --file .workstation/git/config user.email >/dev/null 2>&1; then
  log_status "{{CLIENT}}: git identity not set (edit .workstation/git/config); commits are blocked until it is"
fi
for _f in .workstation/git/config .workstation/npm/npmrc .workstation/terraform/terraformrc \
          .workstation/python/pip.conf .aws/config; do
  if [ -f "$_f" ] && grep -v '^[[:space:]]*[#;]' "$_f" | grep -q 'REPLACE_ME'; then
    log_status "{{CLIENT}}: unfilled REPLACE_ME placeholder in $_f"
  fi
done
unset _f
