# Exceptions for scripts/check-workstation-portability.sh.
# Format: <LABEL>:<path relative to this directory>:<extended regex for the matched value>
# An entry excuses only that label, in that file, for a matched value matching the regex.
# Keep entries narrow and say why. Comment lines are scanned too.

# Homebrew's standard prefix on Linux is a fixed system path, not a user home.
ABS-HOME-PATH:bin/watch.sh:/home/linuxbrew$
